APP_NAME="Pondok Berkah Bersama"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pondok_berkah
DB_USERNAME=postgres
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PREFIX=
# Optional outside Google Cloud. Prefer Application Default Credentials in production.
GOOGLE_APPLICATION_CREDENTIALS=
MAIL_MAILER=log
SUPERADMIN_EMAIL=superadmin@pondokberkah.test
ADMIN_EMAIL=admin@pondokberkah.test
# Required in production; local sample defaults are documented in README.
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
ABK_API_KEY=
# Optional during zero-downtime key rotation.
ABK_API_PREVIOUS_KEY=
