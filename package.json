{
  "name": "pondok-berkah-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:components": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "check:php": "node scripts/check-php.mjs",
    "check:blade": "node scripts/check-blade.mjs",
    "check": "pnpm run check:php && pnpm run check:blade && pnpm run typecheck && pnpm run test:components",
    "check:all": "pnpm run check && pnpm run test:browser"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@inertiajs/react": "3.9.1",
    "@tanstack/react-table": "8.21.3",
    "bootstrap": "~5.3.3",
    "date-fns": "4.4.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-bootstrap": "2.10.10",
    "react-datepicker": "9.1.0",
    "react-dom": "19.3.0",
    "react-select": "5.10.2",
    "react-toastify": "11.1.0",
    "recharts": "3.10.1",
    "sweetalert2": "11.26.25"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "26.1.0",
    "laravel-vite-plugin": "1.3.0",
    "php-parser": "^3.4.0",
    "sass": "1.76.0",
